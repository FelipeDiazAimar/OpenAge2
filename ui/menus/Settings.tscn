[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/menus/Settings.gd" id="1_settings"]

[node name="Settings" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Fondo" type="ColorRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
; Piedra oscura medieval (la madera y remaches los pinta Settings.gd).
color = Color(0.12, 0.1, 0.08, 1)

[node name="Margen" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_top = 24
theme_override_constants/margin_bottom = 24

[node name="Panel" type="PanelContainer" parent="Margen"]
unique_name_in_owner = true
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Margen/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Titulo" type="Label" parent="Margen/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.38, 1)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 2
theme_override_font_sizes/font_size = 32
text = "OPCIONES"
horizontal_alignment = 1

[node name="Subtitulo" type="Label" parent="Margen/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.87, 0.76, 0.55, 1)
text = "Video, audio y controles. Se guarda en user://settings.cfg."
horizontal_alignment = 1

[node name="Pestanas" type="TabContainer" parent="Margen/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0
; Pestañas como sellos de cera: el StyleBox completo lo pone Settings.gd.
theme_override_colors/font_selected_color = Color(1, 0.82, 0.38, 1)
theme_override_colors/font_unselected_color = Color(0.87, 0.76, 0.55, 1)
theme_override_colors/font_hover_color = Color(1, 0.82, 0.38, 1)

[node name="Video" type="Control" parent="Margen/Panel/VBox/Pestanas"]
layout_mode = 2

[node name="VideoBox" type="VBoxContainer" parent="Margen/Panel/VBox/Pestanas/Video"]
