[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://ui/menus/MenuBackdrop.gd" id="1"]

[sub_resource type="Shader" id="Shader_glow"]
code = "shader_type canvas_item;\n// Halo radial procedural: disco + resplandor con color ajustable.\nuniform vec4 tint : source_color = vec4(1.0, 0.6, 0.25, 1.0);\nvoid fragment() {\n\tfloat d = length(UV - vec2(0.5)) * 2.0;\n\tfloat disco = smoothstep(0.30, 0.12, d);\n\tfloat halo = pow(clamp(1.0 - d, 0.0, 1.0), 2.2);\n\tvec3 col = mix(tint.rgb, vec3(1.0, 0.95, 0.85), disco);\n\tCOLOR = vec4(col, clamp(disco + halo * 0.7, 0.0, 1.0));\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sun"]
shader = SubResource("Shader_glow")
shader_parameter/tint = Color(1, 0.8, 0.5, 1)

[sub_resource type="ShaderMaterial" id="ShaderMaterial_torch"]
shader = SubResource("Shader_glow")
shader_parameter/tint = Color(1, 0.52, 0.18, 1)

[sub_resource type="Shader" id="Shader_vig"]
code = "shader_type canvas_item;\n// Vineta cinematografica: oscurece los bordes del menu.\nvoid fragment() {\n\tvec2 p = UV - vec2(0.5, 0.55);\n\tp.x *= 1.5;\n\tfloat d = length(p);\n\tfloat v = smoothstep(0.55, 1.05, d);\n\tCOLOR = vec4(0.02, 0.01, 0.05, v * 0.6);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vig"]
shader = SubResource("Shader_vig")

