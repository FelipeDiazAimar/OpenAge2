# Sprites extraídos del AoE2:DE (propiedad de Microsoft).
# Cada uno regenera los suyos con tools/extract_aoe2_sprites.py (ver docs/SPRITES.md).
# Se versionan los manifests + script, NO los PNG (pesan y no son redistribuibles).
assets/sprites/**/p_*.png
assets/sprites/**/m_*.png
assets/sprites/**/frame_*.png
assets/sprites/**/*.import
# Muestras extraídas del juego (copyright): se regeneran en user://
assets/ui_extraidos/*.png
assets/ui_extraidos/*.import
assets/sonidos_extraidos/*

